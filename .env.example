# ---- AvsarPath environment variables ----
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; never commit real keys.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase project (create a free project at https://supabase.com, then
# Project Settings -> API). The URL and anon key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service-role key: SERVER-ONLY. Never prefix with NEXT_PUBLIC and never
# expose to the client. Used only by server-side admin/privileged actions.
SUPABASE_SERVICE_ROLE_KEY=""
